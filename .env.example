# Copy to .env.local and fill in values. Never commit .env.local.
#
# Next.js loads .env.local automatically in dev. Scripts use:
#   node --env-file=.env.local scripts/...

# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical app URL for Google OAuth redirects (local: localhost; production: Vercel domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only
SUPABASE_SERVICE_ROLE_KEY=

# Slug of the default organisation for first sign-in bootstrap (V1 single-tenant)
DEFAULT_ORG_SLUG=previously-unavailable

# Comma-separated email domains treated as internal (team) for sync matching
ORG_INTERNAL_EMAIL_DOMAINS=previously.co

# Cron authentication (verified on all /api/cron/* routes)
CRON_SECRET=

# Gmail sync (schema ready — implementation not started; see docs/specs/gmail-sync.md)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GMAIL_SYNC_LABELS=INBOX

# Google Calendar sync (Phase 1.1 — shipped)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback

# Calendar backfill window (optional — defaults: 14 months back, 6 weeks forward)
# CALENDAR_BACKFILL_FROM=2025-06-01
# CALENDAR_BACKFILL_MONTHS=14
# CALENDAR_LOOKAHEAD_WEEKS=6
# Comma-separated substrings to skip (default excludes 31 Crummer rooms)
# CALENDAR_SYNC_IGNORE_SUBSTRINGS=31 crummer,31_crummer
# Pages per backfill chunk (~250 events/page; default 2 ≈ 500 events)
# CALENDAR_SYNC_MAX_PAGES_PER_CHUNK=2

# Token encryption (OAuth refresh tokens — Gmail + Calendar)
TOKEN_ENCRYPTION_KEY=

# Phase 3 AI (not required until agent workflows)
ANTHROPIC_API_KEY=
