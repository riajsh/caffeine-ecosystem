# Public (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Canonical app URL for Google OAuth redirects (production: your Vercel domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEFAULT_ORG_SLUG=previously-unavailable

# Comma-separated email domains treated as internal (team) for sync matching.
# PU production: previously.co
ORG_INTERNAL_EMAIL_DOMAINS=previously.co

# Cron authentication (verified on all /api/cron/* routes)
CRON_SECRET=

# Gmail sync (schema ready — implementation not started; see docs/specs/gmail-sync.md)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GMAIL_SYNC_LABELS=INBOX

# Google Calendar sync (Phase 1.1 — shipped)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback

# Token encryption (OAuth refresh tokens — Gmail + Calendar)
TOKEN_ENCRYPTION_KEY=

# Phase 3 AI (not required until agent workflows)
ANTHROPIC_API_KEY=
