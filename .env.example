# Public (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required in production for magic-link redirects (use your canonical app URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEFAULT_ORG_SLUG=previously-unavailable

# Gmail sync (deferred — not required until /api/cron/gmail-sync is implemented)
# CRON_SECRET=
# GOOGLE_GMAIL_CLIENT_ID=
# GOOGLE_GMAIL_CLIENT_SECRET=
# GOOGLE_GMAIL_REDIRECT_URI=
# GMAIL_SYNC_LABELS=

