# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: used for magic-link redirects in local dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only
SUPABASE_SERVICE_ROLE_KEY=

# Slug of the default organisation for first sign-in bootstrap (V1 single-tenant)
DEFAULT_ORG_SLUG=

# Google OAuth — Gmail sync (Phase 1)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google OAuth — Calendar sync (Phase 1.1)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback

# Gmail sync
# Comma-separated Gmail label names or IDs to include in sync
GMAIL_SYNC_LABELS=INBOX

# Token encryption (used for storing OAuth refresh tokens)
TOKEN_ENCRYPTION_KEY=

# Cron authentication (verified on all /api/cron/* routes)
CRON_SECRET=
